PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Postgres Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orchestr
POSTGRES_PASSWORD=orchestr
POSTGRES_DB=orchestr_dev
DATABASE_URL=postgresql://orchestr:orchestr@localhost:5432/orchestr_dev

# Connection Pool Settings
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=2000
POSTGRES_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
